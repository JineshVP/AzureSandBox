{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-MY-SANDBOX"
		},
		"ADLS_SQL_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_SQL_PARQUET'"
		},
		"LNK_SQLSERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LNK_SQLSERVER'"
		},
		"ADLS_SQL_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsmysandbox.dfs.core.windows.net/"
		},
		"LNK_SQLSERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "JINESH"
		},
		"LNK_SQLSERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DATAWAREHOUSE"
		},
		"LNK_SQLSERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-MY-SANDBOX_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLS_SQL_PARQUET_accountKey": {
						"value": "[parameters('ADLS_SQL_PARQUET_accountKey')]"
					},
					"LNK_SQLSERVER_password": {
						"value": "[parameters('LNK_SQLSERVER_password')]"
					},
					"ADLS_SQL_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('ADLS_SQL_PARQUET_properties_typeProperties_url')]"
					},
					"LNK_SQLSERVER_properties_typeProperties_server": {
						"value": "[parameters('LNK_SQLSERVER_properties_typeProperties_server')]"
					},
					"LNK_SQLSERVER_properties_typeProperties_database": {
						"value": "[parameters('LNK_SQLSERVER_properties_typeProperties_database')]"
					},
					"LNK_SQLSERVER_properties_typeProperties_userName": {
						"value": "[parameters('LNK_SQLSERVER_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}